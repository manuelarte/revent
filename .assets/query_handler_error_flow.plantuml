@startuml
database "R-Event" as Server order 50
participant QueryRequester as Client1 order 0
participant QueryResponder as Client2 order 100

== Registering ==

Client1 -> Server: RegisterClient
activate Client1
Server --> Client1: ClientRegistered
deactivate Client1

Client2 -> Server: RegisterClient(users.GetAll)
activate Client2
Server --> Client2: ClientRegistered
deactivate Client2

== Query Handling: Handler not found ==

Client1 -> Server: QueryRequest(id1, users.GetById)
activate Client1
Server -> Client1: QueryRequestedFailed(QueryHandlerNotFound)
deactivate Client1

== Query Handling: Query timed out ==

Client1 -> Server: QueryRequest(id1, users.GetAll)
activate Client1
Server -> Client2: QueryRequested(id1, users.GetAll)
activate Client2
Client2 -x Server: QueryResponse(id1, users.GetAll)
deactivate Client2
Server -> Client1: QueryRequestedFailed(QueryTimedOut)
deactivate Client1

@enduml
